# Optional. If set, low-star reviews that keyword rules can't label are sent to Claude Haiku.
ANTHROPIC_API_KEY=
# Optional override of the classifier model (default: claude-haiku-5-5)
LEADLINE_AI_MODEL=claude-haiku-5-5
# Cap on AI-classified reviews per run, to keep cost tiny
LEADLINE_AI_MAX_REVIEWS=300
