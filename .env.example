# AI is optional. With no key, everything still runs on rules and costs nothing.

# FREE option (recommended): Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default tries gemini-flash-lite-latest, then gemini-flash-latest)
GEMINI_MODEL=

# PAID option (optional): Claude. Used only if GEMINI_API_KEY is empty, or if forced below.
ANTHROPIC_API_KEY=
LEADLINE_AI_MODEL=claude-haiku-5-5

# Force a provider: gemini | anthropic | none
LEADLINE_AI_PROVIDER=
# Cap on AI-classified reviews per run
LEADLINE_AI_MAX_REVIEWS=300
